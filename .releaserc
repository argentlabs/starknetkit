{
  "branches": [
    "main",
    {
      "name": "develop",
      "channel": "next"
    },
    {
      "name": "beta",
      "prerelease": true
    }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/npm",
    "@semantic-release/github"
  ],
  "repositoryUrl": "git@github.com:argentlabs/starknetkit.git"
}
